# ACM certificate for the domain. CloudFront requires us-east-1 regardless of stack region.
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
# Route 53 hosted zone that owns the domain.
HOSTED_ZONE_ID=Z0000000000000000000
# Optional; defaults to samplepayer.tvlss.com in template.yaml.
DOMAIN_NAME=samplepayer.tvlss.com
# Optional. Budget and traffic alerts go here; empty disables them.
NOTIFICATION_EMAIL=you@example.com
